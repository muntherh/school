# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Get both strings from the Supabase dashboard:
#   Project -> Connect -> ORMs (Prisma), or Project Settings -> Database.
# Replace [PROJECT-REF], [PASSWORD] and [REGION] with your project's values.
#
# DATABASE_URL = pooled "Transaction" connection (PgBouncer, port 6543).
#   Used by the running app. Keep the ?pgbouncer=true flag so Prisma disables
#   prepared statements, which the transaction pooler does not support.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = direct "Session" connection (port 5432).
#   Used only by `prisma migrate` / introspection, which cannot run through the pooler.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# For purely local development against a self-hosted Postgres instead of Supabase,
# point both at the same local database, e.g.:
#   DATABASE_URL="postgresql://sdms:sdms@localhost:5432/sdms"
#   DIRECT_URL="postgresql://sdms:sdms@localhost:5432/sdms"

# ---------------------------------------------------------------------------
# Session (iron-session) — unchanged, not provided by Supabase
# ---------------------------------------------------------------------------
SESSION_SECRET="replace-with-at-least-32-random-characters"
SESSION_MAX_AGE="28800"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
